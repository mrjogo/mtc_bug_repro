<?xml version="1.0"?>
<robot name="minimal_robot">

  <!-- Planning Groups -->

  <!-- Turntable Group -->
  <group name="turntable">
    <joint name="turntable_joint"/>
  </group>

  <!-- Gripper Group -->
  <group name="gripper">
    <joint name="gripper_left_finger_joint"/>
    <joint name="gripper_right_finger_joint"/>
  </group>

  <!-- Full Robot Group (combining all groups) -->
  <group name="full_robot">
    <group name="gripper"/>
    <group name="turntable"/>
  </group>

  <!-- Group States -->

  <!-- Turntable Poses -->
  <group_state name="open" group="turntable">
    <joint name="turntable_joint" value="0"/>
  </group_state>

  <group_state name="close" group="turntable">
    <joint name="turntable_joint" value="3.14159"/>
  </group_state>

  <!-- Gripper Poses -->
  <group_state name="close" group="gripper">
    <joint name="gripper_left_finger_joint" value="0.0"/>
    <joint name="gripper_right_finger_joint" value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper_left_finger_joint" value="0.05"/>
    <joint name="gripper_right_finger_joint" value="0.05"/>
  </group_state>

  <!-- Disable Collisions -->

  <!-- Disable collisions between world and attached links -->
  <disable_collisions link1="world" link2="turntable_base" reason="Adjacent"/>
  <disable_collisions link1="world" link2="gripper_base" reason="Adjacent"/>

  <!-- Disable collisions within gripper assembly -->
  <disable_collisions link1="gripper_base" link2="gripper_left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_finger" link2="gripper_right_finger" reason="Never"/>

  <!-- Disable collisions between turntable and gripper (they're separate mechanisms) -->
  <disable_collisions link1="turntable_base" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="turntable_base" link2="gripper_left_finger" reason="Never"/>
  <disable_collisions link1="turntable_base" link2="gripper_right_finger" reason="Never"/>

</robot>
